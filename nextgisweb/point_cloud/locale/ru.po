msgid "Elevation min percentile"
msgstr "Минимальный процентиль высоты"

#: nodepkg/style-widget/EditorWidget.tsx:36
msgid "Elevation max percentile"
msgstr "Максимальный процентиль высоты"

#: nodepkg/style-widget/EditorWidget.tsx:37
msgid "Ramp start color"
msgstr "Начальный цвет шкалы"

#: nodepkg/style-widget/EditorWidget.tsx:38
msgid "Ramp end color"
msgstr "Конечный цвет шкалы"

#: nodepkg/style-widget/EditorWidget.tsx:39
msgid "Modulate by intensity"
msgstr "Модулировать по интенсивности"

