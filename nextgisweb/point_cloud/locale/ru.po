msgid "Classification colors"
msgstr "Цвета классов"

#: nodepkg/style-widget/EditorWidget.tsx:56
msgid "Choose how point cloud colors are calculated."
msgstr "Выберите способ вычисления цветов облака точек."

#: nodepkg/style-widget/EditorWidget.tsx:57
msgid "Sets the rendered size of each point."
msgstr "Задаёт отображаемый размер каждой точки."

#: nodepkg/style-widget/EditorWidget.tsx:58
msgid "Controls overall transparency of the point cloud."
msgstr "Управляет общей прозрачностью облака точек."

#: nodepkg/style-widget/EditorWidget.tsx:59
msgid "Maximum number of points rendered in the current view."
msgstr "Максимальное количество точек, отображаемых в текущей области просмотра."

#: nodepkg/style-widget/EditorWidget.tsx:60
msgid "Ignore extreme elevation outliers when coloring points."
msgstr "Игнорировать экстремальные выбросы высоты при окрашивании точек."

#: nodepkg/style-widget/EditorWidget.tsx:61
msgid "Lower elevation percentile used for color ramp scaling."
msgstr "Нижний процентиль высоты для масштабирования цветовой шкалы."

#: nodepkg/style-widget/EditorWidget.tsx:62
msgid "Upper elevation percentile used for color ramp scaling."
msgstr "Верхний процентиль высоты для масштабирования цветовой шкалы."

#: nodepkg/style-widget/EditorWidget.tsx:63
msgid "Color assigned to the lowest elevations in range."
msgstr "Цвет, назначаемый минимальным высотам диапазона."

#: nodepkg/style-widget/EditorWidget.tsx:64
msgid "Color assigned to the highest elevations in range."
msgstr "Цвет, назначаемый максимальным высотам диапазона."

#: nodepkg/style-widget/EditorWidget.tsx:65
msgid "Adjust colors using point intensity values."
msgstr "Корректировать цвета с учётом значений интенсивности точек."

#: nodepkg/style-widget/EditorWidget.tsx:66
msgid "Map classification codes to colors, one per line."
msgstr "Задайте соответствие кодов классификации цветам, по одному на строку."

#: validation.py:48 validation.py:171
msgid "Unable to parse the point cloud coordinate system."
msgstr "Не удалось разобрать систему координат облака точек."

#: validation.py:108
msgid ""
"The specified coordinate system does not match the coordinate system of the "
"point cloud file."
msgstr ""
"Указанная система координат не соответствует системе координат файла облака "
"точек."

#: validation.py:117
msgid "The point cloud file has no coordinate system info. Specify it manually."
msgstr "В файле облака точек нет информации о системе координат. Укажите её вручную."

#: validation.py:128
msgid ""
"Several matching coordinate systems are registered in NextGIS Web. Specify "
"one of them."
msgstr ""
"В NextGIS Web зарегистрировано несколько подходящих систем координат. Укажите"
" одну из них."

#: validation.py:136
msgid ""
"The point cloud coordinate system could not be identified. Make sure the file"
" has a recognized EPSG coordinate system."
msgstr ""
"Система координат облака точек не может быть определена. Убедитесь, что файл "
"имеет распознанную систему координат EPSG."

#: validation.py:143
msgid ""
"The point cloud coordinate system ({auth}) is not registered in NextGIS Web. "
"Add it to the list of supported coordinate systems first."
msgstr ""
"Система координат облака точек ({auth}) не зарегистрирована в NextGIS Web. "
"Сначала добавьте её в список поддерживаемых систем координат."

#: validation.py:154
msgid "Invalid COPC point cloud."
msgstr "Некорректное облако точек COPC."

#: validation.py:161
msgid "Only COPC point formats 6, 7, and 8 are supported."
msgstr "Поддерживаются только форматы точек COPC 6, 7 и 8."

#: validation.py:165
msgid "The COPC hierarchy is empty or corrupted."
msgstr "Иерархия COPC пуста или повреждена."

#: view.py:46
msgid "Cloud Optimized Point Cloud"
msgstr "Cloud Optimized Point Cloud"

#: view.py:48
msgid ""
"A Cloud Optimized Point Cloud (COPC) is a LAZ file with an internal "
"organization that allows clients to read only the parts they need using HTTP "
"range requests. To open it in QGIS, use Layer > Add Layer > Add Point Cloud "
"Layer, select the HTTP(S) protocol and paste this URL."
msgstr ""
"Cloud Optimized Point Cloud (COPC) — это LAZ-файл с внутренней организацией, "
"которая позволяет клиентам читать только нужные части с помощью HTTP-запросов"
" диапазонов (range requests). Чтобы открыть его в QGIS, выберите Слой > "
"Добавить слой > Добавить слой облака точек, укажите протокол HTTP(S) и "
"вставьте этот URL."
