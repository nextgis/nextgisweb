#: model.py:210 nodepkg/style-widget/EditorWidget.tsx:215
msgid "Point cloud style"
msgstr "Стиль облака точек"

#: model.py:226
msgid "Point size must be greater than zero."
msgstr "Размер точки должен быть больше нуля."

#: model.py:228
msgid "Opacity must be between 0 and 100."
msgstr "Непрозрачность должна быть от 0 до 100."

#: model.py:231
msgid "Point budget must be between {min} and {max}."
msgstr "Бюджет точек должен быть от {min} до {max}."

#: model.py:237
msgid "Minimum elevation percentile must be between 0 and 100."
msgstr "Минимальный процентиль высоты должен быть от 0 до 100."

#: model.py:241
msgid "Maximum elevation percentile must be between 0 and 100."
msgstr "Максимальный процентиль высоты должен быть от 0 до 100."

#: model.py:246
msgid "Minimum elevation percentile must be less than maximum percentile."
msgstr "Минимальный процентиль высоты должен быть меньше максимального процентиля."

#: model.py:253
msgid "RGB styling is available only for point clouds with RGB data."
msgstr "Стиль RGB доступен только для облаков точек с данными RGB."

#: model.py:258
msgid "Classification styling is available only when classification data is present."
msgstr "Стиль по классификации доступен только при наличии данных классификации."

#: model.py:264
msgid "Intensity styling is available only when intensity data is present."
msgstr "Стиль по интенсивности доступен только при наличии данных интенсивности."

#: model.py:270
msgid "Return number styling is available only when return information is present."
msgstr ""
"Стиль по номеру отражения доступен только при наличии информации об "
"отражениях."

